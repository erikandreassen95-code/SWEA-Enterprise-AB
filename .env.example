# Vercel sätter VERCEL_ENV automatiskt; ange den inte manuellt.
# Ange SITE_INDEXABLE=true först när domän, kontaktflöde och innehåll är verifierade.
SITE_URL=https://www.sweaenterprise.se
SITE_INDEXABLE=false

# Hemliga värden: lägg endast i Vercels miljövariabler, aldrig i Git.
RESEND_API_KEY=

# Resend kräver verifierad avsändardomän. Mottagaradressen måste ha en fungerande inkorg.
CONTACT_FROM_EMAIL=SWEA Enterprise AB <info@sweaenterprise.se>
CONTACT_TO_EMAIL=anton@sweaenterprise.se

# SiteCMS kör endast vid bygg/synkning på servern. CMS_SITE är den verkliga
# webbplatssluggen från SiteCMS-panelen. Lämna tomt tills den är känd.
CMS_API_URL=https://sitecms.se
CMS_SITE=
CMS_API_KEY=
# Sätt true i Vercel Production när den verifierade SiteCMS-integrationen är klar.
CMS_REQUIRED=false
# CMS-ändringar publiceras genom manuell Redeploy i Vercel.
