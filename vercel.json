{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --ignore-scripts",
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "sweaenterprise.se"
        }
      ],
      "destination": "https://www.sweaenterprise.se/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/kock-event/",
      "has": [
        {
          "type": "cookie",
          "key": "sitecms_preview_active",
          "value": "1"
        }
      ],
      "destination": "/api/page?path=/tjanster/kock-event/"
    },
    {
      "source": "/kock-event",
      "has": [
        {
          "type": "cookie",
          "key": "sitecms_preview_active",
          "value": "1"
        }
      ],
      "destination": "/api/page?path=/tjanster/kock-event/"
    },
    {
      "source": "/extra-hand-konsult/",
      "has": [
        {
          "type": "cookie",
          "key": "sitecms_preview_active",
          "value": "1"
        }
      ],
      "destination": "/api/page?path=/tjanster/extra-hand-konsult/"
    },
    {
      "source": "/extra-hand-konsult",
      "has": [
        {
          "type": "cookie",
          "key": "sitecms_preview_active",
          "value": "1"
        }
      ],
      "destination": "/api/page?path=/tjanster/extra-hand-konsult/"
    },
    {
      "source": "/uthyrning/",
      "has": [
        {
          "type": "cookie",
          "key": "sitecms_preview_active",
          "value": "1"
        }
      ],
      "destination": "/api/page?path=/tjanster/uthyrning/"
    },
    {
      "source": "/uthyrning",
      "has": [
        {
          "type": "cookie",
          "key": "sitecms_preview_active",
          "value": "1"
        }
      ],
      "destination": "/api/page?path=/tjanster/uthyrning/"
    },
    {
      "source": "/bygg-montage-installation/",
      "has": [
        {
          "type": "cookie",
          "key": "sitecms_preview_active",
          "value": "1"
        }
      ],
      "destination": "/api/page?path=/tjanster/bygg-montage-installation/"
    },
    {
      "source": "/bygg-montage-installation",
      "has": [
        {
          "type": "cookie",
          "key": "sitecms_preview_active",
          "value": "1"
        }
      ],
      "destination": "/api/page?path=/tjanster/bygg-montage-installation/"
    },
    {
      "source": "/fiber-natverk/",
      "has": [
        {
          "type": "cookie",
          "key": "sitecms_preview_active",
          "value": "1"
        }
      ],
      "destination": "/api/page?path=/tjanster/fiber-natverk/"
    },
    {
      "source": "/fiber-natverk",
      "has": [
        {
          "type": "cookie",
          "key": "sitecms_preview_active",
          "value": "1"
        }
      ],
      "destination": "/api/page?path=/tjanster/fiber-natverk/"
    },
    {
      "source": "/about/",
      "has": [
        {
          "type": "cookie",
          "key": "sitecms_preview_active",
          "value": "1"
        }
      ],
      "destination": "/api/page?path=/om-anton/"
    },
    {
      "source": "/about",
      "has": [
        {
          "type": "cookie",
          "key": "sitecms_preview_active",
          "value": "1"
        }
      ],
      "destination": "/api/page?path=/om-anton/"
    },
    {
      "source": "/",
      "destination": "/api/page?path=/"
    },
    {
      "source": "/:page(tjanster|om-anton|utforda-jobb|kontakt|integritet)/",
      "destination": "/api/page?path=/:page/"
    },
    {
      "source": "/tjanster/:slug/",
      "destination": "/api/page?path=/tjanster/:slug/"
    },
    {
      "source": "/:page(tjanster|om-anton|utforda-jobb|kontakt|integritet)",
      "destination": "/api/page?path=/:page/"
    },
    {
      "source": "/tjanster/:slug",
      "destination": "/api/page?path=/tjanster/:slug/"
    },
    {
      "source": "/index.html",
      "destination": "/api/page?path=/"
    },
    {
      "source": "/:page(tjanster|om-anton|utforda-jobb|kontakt|integritet)/index.html",
      "destination": "/api/page?path=/:page/"
    },
    {
      "source": "/tjanster/:slug/index.html",
      "destination": "/api/page?path=/tjanster/:slug/"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://sitecms.se https://www.sitecms.se https://sitecms-zeta.vercel.app"
        }
      ]
    }
  ]
}
