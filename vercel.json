{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "sweaenterprise.se" }],
      "destination": "https://www.sweaenterprise.se/:path*",
      "permanent": true
    }
  ]
}
